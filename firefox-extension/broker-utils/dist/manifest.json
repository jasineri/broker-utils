{
  "manifest_version": 2,
  "name": "Broker Utils",
  "version": "0.1.13",
  "author": "jasineri @github.com/jasineri/broker-utils",
  "description": "This project is an independent, unofficial third-party tool. The Firefox extension adds an optional, locally executed feature to the Scalable Broker user interface.",
  "icons": {
    "48": "icons/icon.svg"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["https://de.scalable.capital/*"],
      "js": ["utils.broker.js"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "broker-utils@jasineri.de",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}